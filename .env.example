NODE_ENV=development
PORT=3000
HOST=0.0.0.0
API_PREFIX=api/v1
HTTP_BODY_LIMIT_BYTES=1048576
HTTP_COMPRESSION_THRESHOLD_BYTES=1024
HTTP_COMPRESSION_LEVEL=1
HTTP_BROTLI_QUALITY=4
TRUST_PROXY=false

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=multi_courier
DATABASE_POOL_SIZE=10
DATABASE_CONNECT_TIMEOUT_MS=5000

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
BULK_MAX_ORDERS=100
BULK_CONCURRENCY=10

URBANEBOLT_BASE_URL=https://uat.urbanebolt.in
URBANEBOLT_AUTH_PATH=/api/v1/auth/getToken/
URBANEBOLT_USERNAME=
URBANEBOLT_PASSWORD=
URBANEBOLT_COOKIE=
URBANEBOLT_CUSTOMER_CODE=
URBANEBOLT_TIMEOUT_MS=10000
URBANEBOLT_RETRY_COUNT=3
URBANEBOLT_MANIFEST_PATH=/api/v1/manifest/
URBANEBOLT_TRACKING_PATH=/api/v1/services/tracking-pub/
URBANEBOLT_CANCELLATION_PATH=/api/v1/services/cancel/
